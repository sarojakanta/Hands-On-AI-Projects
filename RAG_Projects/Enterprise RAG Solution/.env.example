# Copy this file to ".env" and fill in only what you use.
# ".env" is git-ignored. Never commit real keys. Keys are read server-side only
# and are never returned by the API or written to logs.

# ---------------------------------------------------------------- General
LOG_LEVEL=INFO

# ------------------------------------------------- LLM generation defaults
# Provider names: groq | openai | anthropic | ollama | <custom name, see below>
LLM_DEFAULT_PROVIDER=ollama
# Leave empty to use the provider's own default model setting below.
LLM_DEFAULT_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --------------------------------------------------- Optional provider fallback
# When enabled and the primary provider is unavailable / rate limited / out of quota,
# requests go to the fallback provider. The response always says when this happened.
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=

# ------------------------------------------------------------------ Groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=

# ---------------------------------------------------------------- OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=

# ------------------------------------------------------- Anthropic Claude
# Model names change over time. Pick one from the provider's model list in the UI/API
# (GET /api/v1/llm/providers/anthropic/models) instead of relying on a hardcoded default.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_DEFAULT_MODEL=
ANTHROPIC_VERSION=2023-06-01

# ----------------------------------------------------------------- Ollama
# No API key needed. Example model: llama3.1:latest (see "ollama list").
# If this app runs inside Docker and Ollama runs on the host, use
# http://host.docker.internal:11434 and start Ollama with OLLAMA_HOST=0.0.0.0.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=

# ------------------------------------------------ RAG answer generation
# Number of chunks retrieved per question.
RAG_TOP_K=5
# Chunks scoring below this cosine similarity are not given to the LLM (0..1).
RAG_MIN_SCORE=0.25
# Upper bound on the document text placed in the prompt (characters, roughly 4 per token).
RAG_MAX_CONTEXT_CHARS=6000
# Previous question/answer pairs used to understand follow-up questions.
RAG_HISTORY_TURNS=3
# Rewrite follow-up questions into standalone questions before retrieval.
RAG_REWRITE_ENABLED=true
RAG_MAX_QUESTION_CHARS=2000
RAG_MAX_CONVERSATIONS=200

# ------------------------------------------------ Retrieval quality
# vector = embeddings only. hybrid = embeddings + BM25 keyword search merged with reciprocal rank
# fusion (finds exact codes, names and numbers that embeddings blur).
RAG_RETRIEVAL_MODE=hybrid
# Candidates fetched from each search = RAG_TOP_K x this value.
RAG_CANDIDATE_MULTIPLIER=4
RAG_RRF_K=60
# A chunk below RAG_MIN_SCORE is still used when at least this share (0..1) of the question's
# keyword weight appears in it (hybrid mode only).
RAG_LEXICAL_MIN_COVERAGE=0.6
# none | cross-encoder. The cross-encoder reorders candidates; the first use downloads the model
# from Hugging Face (about 90 MB) unless it is already cached.
RAG_RERANKER=none
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ------------------------------------------------------------- Storage
# Everything persistent lives under DATA_DIR (relative paths are relative to the project root):
# the SQLite metadata database, uploaded originals and the Chroma vector index.
DATA_DIR=data
# Metadata database. Leave empty for SQLite in DATA_DIR. For PostgreSQL use e.g.
# postgresql+psycopg://user:password@localhost:5432/rag
DATABASE_URL=
UPLOAD_DIR=
# Vector index backend: chroma (default, embedded, persisted on disk) or pgvector.
VECTOR_STORE=chroma
CHROMA_PATH=
# pgvector only: SQLAlchemy URL of a PostgreSQL database with the pgvector extension.
# Empty -> DATABASE_URL (when that is PostgreSQL).
VECTOR_STORE_URL=
# On the FIRST start with an empty database the files in SEED_DIR are ingested once.
SEED_SAMPLE_DOCS=true
SEED_DIR=sample_docs
MAX_UPLOAD_BYTES=5242880

# ---------------------------------------------------------- Embeddings
# Changing the model makes existing documents "stale" until they are re-indexed
# (POST /api/v1/documents/reindex). Changing the answer-generation LLM never does.
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ------------------------------------------------------------ Chunking
CHUNK_SIZE=300
CHUNK_OVERLAP=50
# sentence  : split at headings, pack whole sentences (original behaviour; overlap only applies when a
#             single sentence is longer than CHUNK_SIZE).
# recursive : split at headings, then paragraph > line > sentence > word > character, merged back with real
#             overlap. Use an overlap of roughly CHUNK_SIZE/3 (e.g. 100) so neighbours share a sentence.
# structure : recursive for prose; Markdown/DOCX tables split by row with the header repeated in every
#             chunk; CSV records are never cut.
# Changing it marks existing documents 'chunking_outdated' until POST /api/v1/documents/reindex.
CHUNK_STRATEGY=sentence

# ------------------------------------- Other OpenAI-compatible providers
# JSON list. "api_key_env" is the NAME of the variable holding the key, not the key itself.
# Example (Together AI):
# OPENAI_COMPATIBLE_PROVIDERS=[{"name":"together","base_url":"https://api.together.xyz/v1","api_key_env":"TOGETHER_API_KEY","default_model":""}]
# TOGETHER_API_KEY=
OPENAI_COMPATIBLE_PROVIDERS=[]

# ------------------------------------------------------------ Operations
# Prometheus metrics at /metrics (request counts and latency by route, rate-limit rejections, index gauges).
METRICS_ENABLED=true
# Per-client limits (requests per minute) on the expensive endpoints. 0 = unlimited. Reads, the document list,
# status polling, static files and health checks are never limited.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LLM_PER_MINUTE=30
RATE_LIMIT_WRITE_PER_MINUTE=30
# Read the client address from X-Forwarded-For. Enable ONLY behind your own reverse proxy; otherwise clients
# could spoof the header to dodge the limits.
TRUST_PROXY_HEADERS=false
# Compose only: password for the optional postgres profile.
# POSTGRES_PASSWORD=change-me
