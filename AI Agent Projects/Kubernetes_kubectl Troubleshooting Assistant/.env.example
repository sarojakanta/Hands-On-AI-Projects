# ──────────────────────────────────────────────────────────────
# Required: Tavily Search API key - get one at https://app.tavily.com
# ──────────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-your-key-here

# ──────────────────────────────────────────────────────────────
# LLM provider selection
# Choose the default provider the app starts with. You can also switch
# providers at runtime from the sidebar. Options: openai | groq | ollama
# ──────────────────────────────────────────────────────────────
LLM_PROVIDER=openai

# ── OpenAI ──────────────────────────────────────────────────────
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here
# Optional model + endpoint overrides
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Groq ────────────────────────────────────────────────────────
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk-your-key-here
# Optional overrides (base URL defaults to Groq's OpenAI-compatible endpoint)
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Ollama (local) ──────────────────────────────────────────────
# No API key required. Make sure `ollama serve` is running and you have
# pulled a model, e.g. `ollama pull llama3.1`.
# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434/v1
