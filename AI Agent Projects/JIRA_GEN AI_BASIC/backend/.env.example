# Set to false to use a live Jira MCP server and LLM
USE_MOCK_DATA=true

# --- LLM (GenAI) ---
# If OPENAI_API_KEY is empty, the app uses a built-in template engine instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# --- Jira MCP server ---
# Command used to launch the MCP server (stdio transport).
MCP_SERVER_COMMAND=
MCP_SERVER_ARGS=

# --- Jira (used by some MCP servers via env) ---
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=DEMO

# CORS origins for the frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
