# ============================================================
# BizAssist environment configuration  (v1.0)
# Copy this file to `.env` and fill in real values:
#   Windows : Copy-Item .env.example .env
#   Unix    : cp .env.example .env
# NEVER commit the real .env file (it is gitignored).
# Defaults run the app fully offline and free (local Ollama + hashing
# embeddings). Set provider keys below to use hosted models.
# ============================================================

# --- App ---
APP_NAME=BizAssist
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string

# --- Database ---
# SQLite for MVP. For Postgres use:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/bizassist
DATABASE_URL=sqlite:///./bizassist.db

# --- Auth ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ============================================================
# LLM configuration (intent wording + grounded replies)
# ============================================================
# Choose the provider: auto | openai | groq | anthropic | openrouter | ollama | mock
#   - auto   : first provider with a key (groq -> openai -> anthropic -> openrouter),
#              else the deterministic mock.
#   - ollama : local models, fully offline and free (DEFAULT).
#   - mock   : force the deterministic offline responder.
# If a chosen provider can't be built (missing key/SDK) the app falls back to
# the mock, so it always runs.
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.2
# Hard override: set true to force the mock regardless of LLM_PROVIDER.
USE_MOCK_LLM=false

# IMPORTANT: never put a comment on the same line as a value — the .env parser
# would read the comment text as part of the value.

# ---- Ollama (local; default; no key needed) ----
# Prereqs: install Ollama (https://ollama.com/download), run it, and
#   ollama pull llama3.1
#   ollama pull nomic-embed-text   (only if you want Ollama embeddings)
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Leave blank for the default http://localhost:11434/v1
OLLAMA_BASE_URL=

# ---- Anthropic Claude (native SDK) ----
# Key from https://console.anthropic.com/settings/keys
# Model ids change over time. Set a model your account can access (list them
# via GET https://api.anthropic.com/v1/models). Newer Claude models reject the
# `temperature` parameter; the client detects this and retries without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Leave blank for the default https://api.anthropic.com
ANTHROPIC_BASE_URL=

# ---- OpenAI (direct) ----
# Key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Leave blank for the default https://api.openai.com/v1
OPENAI_BASE_URL=

# ---- Groq (OpenAI-compatible; fast; free tier) ----
# Key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Leave blank for the default https://api.groq.com/openai/v1
GROQ_BASE_URL=

# ---- OpenRouter (OpenAI-compatible gateway) ----
# Key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Leave blank for the default https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=
OPENROUTER_APP_NAME=BizAssist
OPENROUTER_SITE_URL=http://localhost:8000

# ---- Embeddings (RAG) ----
# hashing : deterministic local embedder (no network, always works) — DEFAULT.
# auto    : follow the chat provider when it supports embeddings
#           (openai / ollama), otherwise fall back to the hashing embedder.
# openai  : OpenAI embeddings (needs OPENAI_API_KEY).
# ollama  : Ollama embeddings (needs `ollama pull nomic-embed-text`).
# NOTE: keep 'hashing' unless you have pulled an Ollama embed model or set an
# OpenAI key — otherwise 'auto' with Ollama will try an embed model you may
# not have, and fall back to hashing anyway.
EMBEDDING_PROVIDER=hashing

# --- RAG / Vector store ---
CHROMA_PERSIST_DIR=./chroma_store
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
# Max characters of retrieved grounding passed to the LLM.
RAG_CONTEXT_MAX_CHARS=2400

# --- Chat limits ---
# Max length of a single student chat message (longer -> 422).
MAX_CHAT_MESSAGE_CHARS=2000
# Prior turns fed back to the LLM for conversational context.
CHAT_HISTORY_TURNS=8

# --- Storage ---
KNOWLEDGE_BASE_DIR=./knowledge_base

# --- Rate limiting (public chat) ---
PUBLIC_CHAT_RATE_LIMIT=20/minute

# --- CORS ---
# Comma-separated allowed origins for the embeddable widget.
# Use "*" for local/demo; set explicit origins (https://site.example) in prod.
CORS_ALLOW_ORIGINS=*
