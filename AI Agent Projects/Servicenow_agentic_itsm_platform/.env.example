# ============================================================================
# Enterprise Agentic ITSM Platform - configuration reference
# Copy to .env and edit. Never commit .env. Secrets belong in your secret store in production.
# ============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=development            # development | production (production enforces secure settings at startup)
LOG_LEVEL=INFO
LOG_JSON=false                 # true => structured JSON logs

# --- Database ----------------------------------------------------------------
# SQLite is for local development. Use PostgreSQL in production and run `alembic upgrade head`.
DATABASE_URL=sqlite:///./data/itsm.db
# DATABASE_URL=postgresql://itsm:CHANGE_ME@localhost:5432/itsm
AUTO_CREATE_TABLES=true        # development convenience; set false in production and use Alembic migrations

# --- Security ----------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-change-me-32b
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12
AUTH_ENABLED=true              # may only be false outside production
# Creates the first admin on startup if it does not exist. Remove the password after first login.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# --- Human approvals -----------------------------------------------------------
APPROVAL_TTL_HOURS=72
# Empty = allowed outside production, forbidden in production (separation of duties).
APPROVAL_ALLOW_SELF_APPROVAL=

# --- ServiceNow ----------------------------------------------------------------
SERVICENOW_MODE=mock           # mock | live
SERVICENOW_INSTANCE=https://YOUR_INSTANCE.service-now.com
SERVICENOW_AUTH=basic          # basic | oauth
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
# OAuth (SERVICENOW_AUTH=oauth): client credentials, or password grant when a username is set
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
SERVICENOW_TIMEOUT=20
SERVICENOW_MAX_RETRIES=3
SERVICENOW_PAGE_SIZE=100
SERVICENOW_MAX_RECORDS=500
# Live writes are off unless explicitly enabled; they also always need a human-approved request.
SERVICENOW_WRITE_ENABLED=false
# Optional JSON overriding tables, fields and write allow-list (see README)
SERVICENOW_FIELD_MAP_FILE=

# --- LLM -----------------------------------------------------------------------
LLM_PROVIDER=mock              # mock | groq | ollama | openai_compatible
LLM_FALLBACK_PROVIDERS=        # comma separated, tried in order when the primary fails, e.g. ollama,mock
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
LLM_COST_PER_1K_INPUT=0        # optional, for cost estimates in the dashboard
LLM_COST_PER_1K_OUTPUT=0

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (OpenAI-compatible endpoint)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# Any OpenAI-compatible API
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
OPENAI_API_KEY=

# --- Knowledge base / RAG --------------------------------------------------------
KNOWLEDGE_DIR=data/knowledge
CHROMA_DIR=data/chroma
# hash (offline, lexical) | sentence_transformers | ollama | openai_compatible
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=               # e.g. nomic-embed-text (ollama) or text-embedding-3-small (hosted)
EMBEDDING_BASE_URL=            # blank for ollama => OLLAMA_BASE_URL
EMBEDDING_API_KEY=
CHUNK_SIZE=800
CHUNK_OVERLAP=100
KNOWLEDGE_MIN_SCORE=0.10      # raise to ~0.3-0.5 with a semantic embedding model
SIMILAR_MIN_SCORE=0.20

# --- Orchestration -----------------------------------------------------------------
MAX_WORKFLOW_STEPS=20          # hard cap on supervisor steps (prevents runaway loops)
MAX_AGENT_RETRIES=2

# --- Dashboard (read by the Streamlit process) ---------------------------------------
API_URL=http://localhost:8000
