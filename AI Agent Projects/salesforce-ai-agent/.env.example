# ═══════════════════════════════════════════════════════════════
#  Salesforce AI Agent — Environment Configuration
#  Copy this file to .env and fill in your values.
#  Never commit .env to git.
# ═══════════════════════════════════════════════════════════════


# ── LLM PROVIDER ────────────────────────────────────────────────
# Pick ONE provider block, uncomment it, leave the others commented.
# Only 3 settings matter: LLM_PROVIDER, LLM_API_KEY, LLM_MODEL.
# The base URL is auto-filled from LLM_PROVIDER.
#
# Supported values: openai | groq | claude | together | ollama | gemini | custom
# Without a valid key the agent uses a rule-based fallback (still works).

# ---- OpenAI ----------------------------------------------------
# Get key: https://platform.openai.com/api-keys  (starts with sk-)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
#   other options: gpt-4o, gpt-4-turbo

# ---- Groq (fast, free tier) ------------------------------------
# Get key: https://console.groq.com  (starts with gsk_)
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_your_groq_key_here
# LLM_MODEL=openai/gpt-oss-120b
#   other options: llama-3.3-70b-versatile, llama-3.1-8b-instant

# ---- Claude (Anthropic) ----------------------------------------
# Get key: https://console.anthropic.com  (starts with sk-ant-)
# LLM_PROVIDER=claude
# LLM_API_KEY=sk-ant-your_anthropic_key_here
# LLM_MODEL=claude-sonnet-4-20250514
#   other options: claude-opus-4-20250514, claude-3-5-haiku-20241022

# ---- Custom (any OpenAI-compatible endpoint) -------------------
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://your-endpoint/v1
# LLM_API_KEY=...
# LLM_MODEL=...


# ── Salesforce Core (always required) ───────────────────────────
# Your Salesforce login username (email address)
SF_USERNAME=you@example.com


# ── MCP Mode ─────────────────────────────────────────────────────
# Controls how the agent calls Salesforce tools.
#
#   none   → Direct SalesforceClient (default). Uses sf CLI.
#            No MCP server needed. Best for development.
#
#   local  → Local stdio MCP server. Spawns mcp_server.py as a
#            child process on your machine. Uses sf CLI for auth.
#            Best for single-user use with MCP tool discovery.
#
#   remote → Remote HTTP MCP server. Calls a deployed mcp_server.py
#            over HTTPS. Uses simple-salesforce REST (not sf CLI).
#            Best for production / multi-user deployments.
#
MCP_MODE=none


# ── Local MCP settings (only needed when MCP_MODE=local) ────────
# Path to mcp_server.py relative to project root.
MCP_SERVER_SCRIPT=mcp_server.py


# ── Remote MCP settings (only needed when MCP_MODE=remote) ──────
# Full URL of your deployed MCP server (no trailing slash)
MCP_SERVER_URL=https://your-mcp-server.onrender.com

# API key that protects your remote MCP server.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Set this SAME value in your cloud host's environment variables.
MCP_API_KEY=


# ── Salesforce REST credentials (only needed when MCP_MODE=remote) ──
# Required because the remote server can't use the sf CLI.
# The sf CLI is not installed on cloud servers.
#
# SF_PASSWORD: your Salesforce password
SF_PASSWORD=

# SF_SECURITY_TOKEN: get from Salesforce → avatar → Settings →
#   Reset My Security Token (it will be emailed to you)
SF_SECURITY_TOKEN=

# SF_DOMAIN: 'login' for production, 'test' for sandboxes
SF_DOMAIN=login


# ── Flask ────────────────────────────────────────────────────────
# Optional. A random secret key for Flask sessions.
# Auto-generated at startup if not set.
FLASK_SECRET_KEY=

# Set to 'false' in production
FLASK_DEBUG=true

# Port to run the Flask app on (default 5000)
PORT=5000
