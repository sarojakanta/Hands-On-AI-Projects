# API credentials for the Multiagentic AI Researcher system.
# Copy this file to .env and fill in your own keys.

# Tavily Search API key (used by the web-search agent).
TAVILY_API_KEY=your_tavily_api_key

# OpenWeather API key with access to Current Weather Data.
OPENWEATHER_API_KEY=your_openweather_api_key

# OpenRouter API key (used by the supervisor and formatter LLM calls).
OPENROUTER_API_KEY=your_openrouter_api_key

# Optional: the OpenRouter model identifier. Defaults to the value below.
# Free (":free") models share rate limits and have a daily per-account cap; if
# you get rate-limited, try another free model from a different provider or add
# your own provider key in OpenRouter settings.
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Optional: web server bind address and port.
# Defaults to 127.0.0.1:5000 locally; the Docker image sets WEB_HOST=0.0.0.0.
# WEB_HOST=127.0.0.1
# WEB_PORT=5000
