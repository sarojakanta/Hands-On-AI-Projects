# ============================================================
# AI-Powered Customer Support Agent - Environment Configuration
# Copy this file to ".env" and fill in your values.
# NEVER commit your real .env file.
# ============================================================

# ---- Flask ----
FLASK_ENV=development
SECRET_KEY=change-me-in-production
HOST=127.0.0.1
PORT=5000

# ---- Development mode ----
# When true, the mock OTP is shown in the UI and dev indicators are enabled.
DEV_MODE=true

# ============================================================
# LLM configuration (text generation: intent detection + replies)
# ============================================================
# OpenAI, Groq, and OpenRouter use an OpenAI-compatible API client.
# Anthropic uses its native Anthropic SDK. Configure the key for the provider
# you want to use; model names are provider-specific.
#
# If NO provider key is set, the app still runs and the agent falls back to
# deterministic (non-LLM) replies.

# Choose: auto | groq | openai | anthropic | openrouter | ollama.
# With auto, the app selects the first provider with a configured API key:
#     groq -> openai -> anthropic -> openrouter
# This is selection priority, not request-time failover: if the selected
# provider returns an error, the app does not try the next provider.
# Ollama is excluded from auto and has a built-in local placeholder key; select
# it explicitly with LLM_PROVIDER=ollama.
LLM_PROVIDER=auto

# IMPORTANT: do NOT put comments on the same line as a value. Keep each value
# clean (e.g. `OPENAI_BASE_URL=`), otherwise the comment text can be read as
# part of the value by the .env parser.

# ---- OpenAI (direct) ----
# Key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Leave blank to use the default https://api.openai.com/v1
OPENAI_BASE_URL=

# ---- Groq (direct, fast, has a free tier) ----
# Key from https://console.groq.com/keys
GROQ_API_KEY=
# Pick a current Groq chat model (model ids change; check https://console.groq.com/docs/models)
GROQ_MODEL=openai/gpt-oss-20b
# Leave blank to use the default https://api.groq.com/openai/v1
GROQ_BASE_URL=

# ---- Anthropic Claude (direct) ----
# Key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# Leave blank to use the default https://api.anthropic.com/v1
ANTHROPIC_BASE_URL=

# ---- OpenRouter (gateway to many models; small markup) ----
# Key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Leave blank to use the default https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=
# Optional attribution headers recommended by OpenRouter (safe to leave as-is).
OPENROUTER_APP_NAME=AI Customer Support Agent
OPENROUTER_SITE_URL=http://localhost:5000

# ---- Ollama (local models; fully offline, free, private) ----
# Explicit-only: this is NOT selected by LLM_PROVIDER=auto. To use it, set
# LLM_PROVIDER=ollama above.
#
# Prerequisites:
#   1. Install Ollama:  https://ollama.com/download
#   2. Pull a model:    ollama pull llama3.1
#   3. Make sure Ollama is running (it serves on port 11434 by default).
#
# No API key is required; a dummy value is used automatically.
OLLAMA_API_KEY=ollama
# Any chat model you've pulled, e.g. llama3.1, qwen2.5, mistral, phi3.
OLLAMA_MODEL=llama3.1
# Leave blank to use the default http://localhost:11434/v1
OLLAMA_BASE_URL=

# ---- Database ----
DATABASE_URL=sqlite:///data/support_agent.db

# ---- RAG ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DIR=data/chroma
KNOWLEDGE_BASE_DIR=knowledge_base
# Staff-only knowledge base (internal playbooks, fraud rules) - NEVER served to
# customers. Indexed into a separate collection (R-7).
STAFF_KB_DIR=knowledge_base_staff
# Token-based chunking (R-1): 300-500 tokens with a small overlap.
CHUNK_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
# Legacy character-based chunking settings; token settings above take priority.
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# Hybrid fusion weight for vector vs BM25 (0..1); higher favors vector search.
HYBRID_VECTOR_WEIGHT=0.5
# Retrieve a larger candidate pool, rerank, then keep the best K (R-3).
RETRIEVAL_TOP_K=4
RETRIEVAL_CANDIDATES=20
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_MIN_SCORE=0.0
# Region/language used to filter retrieval before ranking (R-4).
DEFAULT_REGION=IN
DEFAULT_LANGUAGE=en
# Re-index window after a KB change (R-6), in seconds.
REINDEX_INTERVAL_SECONDS=900

# ---- Memory ----
# Working (per-session) memory. Leave REDIS_URL blank to use the local
# in-process fallback (no Redis needed). SESSION_TTL_SECONDS doubles as the
# idle timeout (30 minutes) - working memory expires after it.
REDIS_URL=
SESSION_TTL_SECONDS=1800
# Episodic + preference (per-customer) memory lives in the relational DB
# (SQLite here; Postgres in production via DATABASE_URL). Episodic entries are
# retained 12 months, then removed by scripts/purge_memory.py.

# ---- Authentication / OTP ----
# Mock provider only. Hardcoded development OTP.
DEV_OTP=123456
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3

# ---- Twilio Verify (currently not wired through app.config.Config) ----
# Keep blank for DEV_MODE=true, which uses the local mock OTP provider.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=

# ---- MCP servers (four domain servers over stdio) ----
# The business tools are split across four domain MCP servers, each fronting a
# (simulated) enterprise system. They are launched automatically by the agent's
# multi-server client over stdio; no host/port needed.
#   crm-mcp       -> CRM (e.g. Salesforce):   send_otp, verify_customer, get_customer_profile
#   oms-mcp       -> OMS (e.g. SAP):           get_order, get_shipment_status, request_address_change
#   helpdesk-mcp  -> Helpdesk (ServiceNow):    create_ticket, escalate_to_human
#   store-mcp     -> Store system:             find_store, get_store_hours
# Set MCP_INPROCESS=1 to run tools in-process (faster; used by tests).
MCP_INPROCESS=
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8765

# ---- Ticket provider ----
# Where support tickets go: "local" (SQLite, default; self-contained) or
# "salesforce" (also creates a Case in a real org). Local always keeps a copy,
# so the human dashboard works either way.
TICKET_PROVIDER=local
# If Salesforce fails, store the ticket locally so it is never lost.
TICKET_FALLBACK_LOCAL=true
# In DEV_MODE with local ticketing, keep at most 50 tickets by deleting the
# oldest RESOLVED/CLOSED tickets first. OPEN and IN_PROGRESS tickets are kept,
# so the total may exceed this cap when there are not enough resolved tickets.
DEV_TICKET_MAX_COUNT=50

# ---- Salesforce (only needed if TICKET_PROVIDER=salesforce) ----
# Current provider uses username, password, security token, and domain.
# Consumer key/secret are reserved settings and are not currently consumed.
# Requires: pip install simple-salesforce
# Set SALESFORCE_DOMAIN=test for a sandbox, login for production.
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_CONSUMER_KEY=
SALESFORCE_CONSUMER_SECRET=
SALESFORCE_DOMAIN=login

# ---- Tool safety (T-3 timeout/retry, T-6 rate limits) ----
# Each tool/LLM call is bounded by this timeout (seconds) with one retry.
TOOL_TIMEOUT_SECONDS=5
TOOL_MAX_RETRIES=1
# Rate limits: tool calls per conversation, OTP requests per customer per hour.
MAX_TOOL_CALLS_PER_CONVERSATION=8
MAX_OTP_REQUESTS_PER_HOUR=5

# ---- Logging ----
LOG_DIR=logs
LOG_LEVEL=INFO
# Dev-mode rotation threshold for each of audit.log, tool_calls.log, and
# guardrail_events.log. 80 MB x (1 active + 3 backups) x 3 logs ~= 960 MB max.
LOG_MAX_MB=80
# Number of older rotated files to retain per log (not the total log count).
LOG_BACKUP_COUNT=3
